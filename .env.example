# 이 파일을 .env로 복사한 뒤 실제 값으로 변경하세요.
# .env는 Git에 커밋되지 않습니다.

# Let's Encrypt 만료/보안 알림 이메일
LETSENCRYPT_EMAIL=admin@example.com

# Oracle Autonomous Database
# Wallet의 tnsnames.ora에 정의된 접속 별칭(예: *_high, *_medium, *_low)
ORACLE_SERVICE_NAME=o14d0nm3uo1d4iud_medium
DB_USERNAME=thing
DB_PASSWORD=change-me

# Oracle Linux 호스트에 압축을 해제한 Wallet 절대 경로
WALLET_PATH=/home/opc/work/wallet

# JVM 메모리 (1GB 서버 기준)
MAIN_JAVA_OPTS=-Xms128m -Xmx256m -XX:+UseSerialGC
ADMIN_JAVA_OPTS=-Xms128m -Xmx256m -XX:+UseSerialGC
